<section class='hero'>
  <h1 class='hero__title'>
    <span class='hero__line'>{{ resume.profile.firstName }}</span>
    <span class='hero__line hero__line_last'>
      {{ resume.profile.lastName }}
    </span>
  </h1>
  <div class='hero__body'>
    <p class='hero__role'>{{ resume.profile.role }}</p>
    <p class='hero__lead'>{{ resume.profile.lead }}</p>
  </div>
</section>
